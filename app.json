{
  "expo": {
    "name": "sound-level-meter",
    "slug": "sound-level-meter",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "soundlevelmeter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sunnyinnolab.decibella2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.sunnyinnolab.decibella2"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "This app needs microphone access for audio analysis.",
          "androidPermissions": [
            "android.permission.RECORD_AUDIO"
          ]
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb9855b4-962b-4ef4-8939-83af8cd3b259"
      }
    }
  }
}